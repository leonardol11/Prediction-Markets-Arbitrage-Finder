# Optional — enables the LLM verification pass. Free keys: https://console.groq.com/keys
GROQ_API_KEY=

# Optional local server overrides
HOST=127.0.0.1
PORT=5000

# Optional — seconds a scan may run before it stops itself (0 = no limit).
# Defaults to 270 on Vercel so scans end cleanly inside the 300s function limit.
# SCAN_TIME_LIMIT=
